{
  "name": "ets-personal-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-single-worker.mjs",
    "deploy": "wrangler deploy --keep-vars",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/app.js && node --check src/index.js && node --check scripts/build-single-worker.mjs && node --check scripts/local-server.mjs",
    "serve": "node scripts/local-server.mjs"
  },
  "devDependencies": {
    "wrangler": "4.100.0"
  }
}
